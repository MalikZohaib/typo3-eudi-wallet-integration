{
  "name": "t3hub/eudi-wallet-integration",
  "description": "TYPO3 14.3 adapter for native EUDI Wallet verification and frontend login using the PHP verifier SDK",
  "type": "typo3-cms-extension",
  "license": "MIT",
  "version": "0.3.4",
  "require": {
    "php": ">=8.2 <8.6",
    "typo3/cms-core": "^14.3",
    "typo3/cms-frontend": "^14.3",
    "typo3/cms-extbase": "^14.3",
    "typo3/cms-fluid": "^14.3",
    "typo3/cms-felogin": "^14.3",
    "typo3/cms-form": "^14.3",
    "malikzohaib/openid4vp-eudi-verifier": "@dev"
  },
  "autoload": {
    "psr-4": {
      "T3Hub\\EudiWalletIntegration\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "eudi_wallet_integration"
    }
  }
}
